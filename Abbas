"use client";
import {useEffect,useState} from "react";import Link from "next/link";import {useRouter} from "next/navigation";import {supabase} from "@/lib/supabase";
export default function Checkout(){const [user,setUser]=useState<any>(null);const [name,setName]=useState("");const [phone,setPhone]=useState("");const [city,setCity]=useState("");const [address,setAddress]=useState("");const [method,setMethod]=useState("COD");const [items,setItems]=useState<any[]>([]);const [msg,setMsg]=useState("");const [busy,setBusy]=useState(false);const router=useRouter();
useEffect(()=>{(async()=>{if(!supabase)return;const {data}=await supabase.auth.getUser();if(!data.user){router.push("/login");return;}setUser(data.user);setName(data.user.user_metadata?.full_name||"");const raw=localStorage.getItem("alkamar_cart");if(raw){try{const cart=JSON.parse(raw);const ids=Object.entries(cart).filter(([,q])=>Number(q)>0).map(([id,q])=>({product_id:id,quantity:Number(q)}));setItems(ids);}catch{localStorage.removeItem("alkamar_cart");}}})();},[router]);
const [products,setProducts]=useState<Record<string,any>>({});
useEffect(()=>{(async()=>{if(!supabase||!items.length)return;const {data}=await supabase.from("products").select("id,name,price,sale_price").in("id",items.map(x=>x.product_id));setProducts(Object.fromEntries((data||[]).map(p=>[p.id,p])));})();},[items]);
const total=items.reduce((s,p)=>s+((Number(products[p.product_id]?.sale_price ?? products[p.product_id]?.price)||0)*p.quantity),0);
async function place(e:React.FormEvent){e.preventDefault();if(!supabase||!user)return;if(!items.length){setMsg("Your cart is empty. Add products from the store.");return;}setBusy(true);const {error}=await supabase.rpc("place_order",{p_customer_name:name,p_phone:phone,p_city:city,p_delivery_address:address,p_payment_method:method,p_items:items});setBusy(false);if(error)setMsg(error.message);else{localStorage.removeItem("alkamar_cart");setItems([]);setMsg("Order placed successfully. We will contact you to confirm delivery.");}}
return <main className="container" style={{padding:"45px 0",maxWidth:760}}><Link href="/" className="brand">ALKAMAR<small>GENERAL STORE</small></Link><div className="panel" style={{marginTop:28}}><h1>Checkout</h1><p className="muted">Delivery details for orders within Pakistan.</p><form onSubmit={place} className="formgrid"><div className="full"><label>Full name</label><input className="field" required value={name} onChange={e=>setName(e.target.value)}/></div><div><label>Phone number</label><input className="field" required placeholder="03XXXXXXXXX" value={phone} onChange={e=>setPhone(e.target.value)}/></div><div><label>City</label><input className="field" required value={city} onChange={e=>setCity(e.target.value)}/></div><div className="full"><label>Complete delivery address</label><textarea className="field" required rows={3} value={address} onChange={e=>setAddress(e.target.value)}/></div><div className="full"><label>Payment method</label><select className="field" value={method} onChange={e=>setMethod(e.target.value)}><option value="COD">Cash on Delivery</option><option value="Easypaisa">Easypaisa (manual transfer)</option><option value="JazzCash">JazzCash (manual transfer)</option></select><div className="notice">For Easypaisa/JazzCash, the store will share merchant transfer instructions and confirm payment manually. Current estimated total: Rs. {total.toLocaleString("en-PK")}. Final amount is calculated securely when your order is submitted.</div></div><div className="full"><b>Order total: Rs. {total.toLocaleString("en-PK")}</b><button className="btn" style={{width:"100%",marginTop:14}} disabled={busy}>{busy?"Placing order…":"Place order"}</button></div></form>{msg&&<div className="notice">{msg}</div>}</div></main>}
